erDiagram
    RESTAURANTS ||--|| BOOKING_RULES : configures
    RESTAURANTS ||--o{ OPENING_HOURS : has
    RESTAURANTS ||--o{ RESTAURANT_TABLES : has
    RESTAURANTS ||--o{ RESERVATIONS : receives
    RESTAURANTS ||--o{ STAFF_USERS : employs
    RESTAURANT_TABLES ||--o{ RESERVATIONS : assigned_to
    CUSTOMERS ||--o{ RESERVATIONS : makes

    RESTAURANTS {
        bigint id PK
        varchar name
        varchar timezone
        int booking_horizon_days
        timestamptz created_at
        timestamptz updated_at
    }

    BOOKING_RULES {
        bigint id PK
        bigint restaurant_id FK
        int reservation_duration_minutes
        int slot_interval_minutes
        int buffer_minutes
        int max_online_party_size
        time first_seating_start
        time first_seating_end
        time second_seating_start
        time second_seating_end
    }

    OPENING_HOURS {
        bigint id PK
        bigint restaurant_id FK
        smallint day_of_week
        time open_time
        time close_time
    }

    RESTAURANT_TABLES {
        bigint id PK
        bigint restaurant_id FK
        int table_number
        int capacity
        boolean is_active
    }

    CUSTOMERS {
        bigint id PK
        varchar name
        varchar email
        varchar phone
        timestamptz created_at
    }

    RESERVATIONS {
        bigint id PK
        bigint restaurant_id FK
        bigint table_id FK
        bigint customer_id FK
        date reservation_date
        time start_time
        time end_time
        int buffer_minutes
        int party_size
        varchar status
        uuid manage_token UK
        timestamptz created_at
        timestamptz cancelled_at
    }

    STAFF_USERS {
        bigint id PK
        bigint restaurant_id FK
        varchar name
        varchar email UK
        varchar password_hash
        varchar role
        boolean is_active
        timestamptz last_login_at
    }
