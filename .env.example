# Configuration template — copy to `.env` (gitignored) and fill in real values.
# Production values live in the Render dashboard "Environment" section, never in git.

# PostgreSQL 16 connection string. Local dev: scripts/db-start.sh runs PostgreSQL on
# localhost:5432 (user postgres, db bookingsystem). Prod: Neon Frankfurt, sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/bookingsystem

# Secret used to sign staff session cookies. Generate a long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Resend API key for the single confirmation email. Optional in development;
# without it, emails are skipped and reservations still succeed.
RESEND_API_KEY=re_change_me

# Password for the admin staff account created by the idempotent seed script.
# Consumed from the environment only — never hardcoded in the seed script.
SEED_ADMIN_PASSWORD=change-me

# development | test | production
ENVIRONMENT=development
